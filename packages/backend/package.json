{
	"name": "@setest/backend",
	"version": "1.0.0",
	"scripts": {
		"dev": "cd ../.. && bun run --watch packages/backend/src/index.ts",
		"build": "bun build src/index.ts --outdir=dist --target=bun",
		"start": "bun run dist/index.js",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.3.3",
		"@elysiajs/jwt": "^1.3.3",
		"@elysiajs/static": "^1.3.0",
		"@elysiajs/swagger": "^1.3.1",
		"@setest/shared": "workspace:*",
		"@t3-oss/env-core": "^0.13.8",
		"drizzle-orm": "^0.44.5",
		"drizzle-zod": "^0.8.3",
		"elysia": "^1.3.21",
		"pg": "^8.16.3",
		"zod": "^4.1.5"
	},
	"devDependencies": {
		"bun-types": "^1.2.21",
		"drizzle-kit": "^0.31.4",
		"@types/pg": "^8.15.5",
		"@types/node": "^24.3.1",
		"typescript": "^5.9.2"
	},
	"module": "src/index.js"
}
